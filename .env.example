# CSDL: PostgreSQL (Supabase / Neon / Vercel Postgres). SQLite không bền vững trên serverless.
# Supabase: Project Settings → Database → Connection string, dùng "Direct connection" (port 5432):
#   postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres?schema=public
# (Tùy chọn scale: sau này dùng Transaction Pooler port 6543 thêm &pgbouncer=true&connection_limit=1)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public"
NEXT_PUBLIC_APP_NAME="SCRIPTLEX"
NEXT_PUBLIC_APP_DESCRIPTION="Tra cứu tiếng Hê-bơ-rơ & Hy-lạp, nghiên cứu Kinh Thánh chuyên sâu"
NEXT_PUBLIC_SITE_URL="https://scriptlex.app"

# Auth — bí mật dùng để ký JWT session (httpOnly cookie). Đặt chuỗi ngẫu nhiên dài khi deploy.
AUTH_SECRET=""

# AI — chọn provider (gemini | openai | ollama | groq). Mỗi provider tự có base URL & model mặc định.
AI_PROVIDER="gemini"
# Khóa API của provider (Gemini: https://aistudio.google.com/apikey; Ollama: để chuỗi bất kỳ).
AI_API_KEY=""
# (Tùy chọn) Ghi đè model mặc định, ví dụ: gemini-2.5-flash, gpt-4o-mini, llama3.1
AI_MODEL=""
# (Tùy chọn) Ghi đè endpoint nếu không dùng preset:
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
