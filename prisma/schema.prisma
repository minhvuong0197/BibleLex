generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StrongEntry {
  id                   String   @id @default(cuid())
  strongNumber         String   @unique @map("strong_number")
  language             Language @map("language")
  transliteration      String   @map("transliteration")
  pronunciation        String?  @map("pronunciation")
  etymology            String?  @map("etymology")
  definition           String   @map("definition")
  kjvDef               String?  @map("kjv_def")
  outlineBiblicalUsage String?  @map("outline_biblical_usage")
  thayersDef           String?  @map("thayers_def")
  bdbDef               String?  @map("bdb_def")
  lsjDef               String?  @map("lsj_def")
  vietnameseDef        String?  @map("vietnamese_def")
  derivation           String?  @map("derivation")
  tdk                  String?  @map("tdk")
  gkNumber             String?  @map("gk_number")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  morphology      Morphology[]
  verses          VerseWord[]
  crossRefs       CrossReference[] @relation("SourceRefs")
  crossRefTargets CrossReference[] @relation("TargetRefs")

  @@index([language])
  @@map("strong_entries")
}

model Morphology {
  id           String   @id @default(cuid())
  strongNumber String   @map("strong_number")
  parsings     String   @map("parsings")
  count        Int      @default(1)
  tense        Tense?
  voice        Voice?
  mood         Mood?
  case_        Case?    @map("case")
  number       Number?
  person       Person?
  gender       Gender?
  createdAt    DateTime @default(now()) @map("created_at")

  strongEntry StrongEntry @relation(fields: [strongNumber], references: [strongNumber])

  @@index([strongNumber])
  @@map("morphologies")
}

model VerseWord {
  id              String   @id @default(cuid())
  book            String
  chapter         Int
  verse           Int
  wordOrder       Int      @map("word_order")
  hebrewGreek     String   @map("hebrew_greek")
  transliteration String   @map("transliteration")
  strongNumber    String?  @map("strong_number")
  parsing         String?
  english         String?
  createdAt       DateTime @default(now()) @map("created_at")

  strongEntry StrongEntry? @relation(fields: [strongNumber], references: [strongNumber])

  @@unique([book, chapter, verse, wordOrder])
  @@index([book, chapter, verse])
  @@index([strongNumber])
  @@map("verse_words")
}

model CrossReference {
  id           String       @id @default(cuid())
  sourceStrong String       @map("source_strong")
  targetStrong String       @map("target_strong")
  type         CrossRefType @default(RELATED)
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  sourceEntry StrongEntry @relation("SourceRefs", fields: [sourceStrong], references: [strongNumber])
  targetEntry StrongEntry @relation("TargetRefs", fields: [targetStrong], references: [strongNumber])

  @@index([sourceStrong])
  @@index([targetStrong])
  @@map("cross_references")
}

model BibleBook {
  id           String    @id @default(cuid())
  name         String    @unique
  abbreviation String    @unique
  testament    Testament
  bookOrder    Int       @unique @map("book_order")
  chapters     Int
  createdAt    DateTime  @default(now()) @map("created_at")

  verses            Verse[]
  verseTranslations VerseTranslation[]

  @@map("bible_books")
}

model Verse {
  id             String   @id @default(cuid())
  bookId         String   @map("book_id")
  chapter        Int
  verse          Int
  text           String
  vietnameseText String?  @map("vietnamese_text")
  kjvText        String?  @map("kjv_text")
  createdAt      DateTime @default(now()) @map("created_at")

  book BibleBook @relation(fields: [bookId], references: [id])

  @@unique([bookId, chapter, verse])
  @@index([bookId, chapter])
  @@map("verses")
}

model VerseCrossReference {
  id          String   @id @default(cuid())
  fromBook    String   @map("from_book")
  fromChapter Int      @map("from_chapter")
  fromVerse   Int      @map("from_verse")
  toBook      String?  @map("to_book")
  toChapter   Int      @map("to_chapter")
  toVerse     Int      @map("to_verse")
  toLabel     String   @map("to_label")
  anchor      String?  @map("anchor")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([fromBook, fromChapter, fromVerse])
  @@map("verse_cross_references")
}

model TopicalEntry {
  id          String   @id @default(cuid())
  topic       String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  references TopicalReference[]

  @@map("topical_entries")
}

model TopicalReference {
  id         String   @id @default(cuid())
  topicId    String   @map("topic_id")
  book       String
  chapter    Int
  verseStart Int      @map("verse_start")
  verseEnd   Int?     @map("verse_end")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  topic TopicalEntry @relation(fields: [topicId], references: [id])

  @@index([topicId])
  @@index([book, chapter, verseStart])
  @@map("topical_references")
}

enum Language {
  HEBREW
  GREEK
}

enum Tense {
  PRESENT
  IMPERFECT
  FUTURE
  AORIST
  PERFECT
  PLUPERFECT
  FUTURE_PERFECT
}

enum Voice {
  ACTIVE
  MIDDLE
  PASSIVE
  MIDDLE_PASSIVE
}

enum Mood {
  INDICATIVE
  SUBJUNCTIVE
  OPTATIVE
  IMPERATIVE
  INFINITIVE
  PARTICIPLE
}

enum Case {
  NOMINATIVE
  GENITIVE
  DATIVE
  ACCUSATIVE
  VOCATIVE
  LOCATIVE
  INSTRUMENTAL
}

enum Number {
  SINGULAR
  PLURAL
  DUAL
}

enum Person {
  FIRST
  SECOND
  THIRD
}

enum Gender {
  MASCULINE
  FEMININE
  NEUTER
}

enum Testament {
  OLD
  NEW
}

enum CrossRefType {
  RELATED
  SYNONYM
  ANTONYM
  ROOT
  DERIVATIVE
  COMPOUND
  CITATION
  ALLUSION
}

model AiAnalysis {
  id           String   @id @default(cuid())
  strongNumber String   @map("strong_number")
  type         String   @map("type")
  content      String
  model        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([strongNumber, type])
  @@index([strongNumber])
  @@map("ai_analyses")
}

model BibleVersion {
  id           String   @id @map("code")
  name         String
  abbreviation String
  language     String   @default("vi")
  year         Int?
  source       String?
  note         String?
  ordinal      Int      @default(0)
  public       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  translations VerseTranslation[]

  @@index([ordinal])
  @@map("bible_versions")
}

model VerseTranslation {
  id        String   @id @default(cuid())
  bookId    String   @map("book_id")
  chapter   Int
  verse     Int
  versionId String   @map("version_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book    BibleBook    @relation(fields: [bookId], references: [id])
  version BibleVersion @relation(fields: [versionId], references: [id])

  @@unique([bookId, chapter, verse, versionId])
  @@index([bookId, chapter])
  @@index([versionId])
  @@map("verse_translations")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String   @map("password_hash")
  emailVerified     Boolean  @default(false) @map("email_verified")
  verifyToken       String?  @map("verify_token")
  verifyTokenExpiry DateTime? @map("verify_token_expiry")
  resetToken        String?  @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  notes      Note[]
  bookmarks  Bookmark[]
  highlights Highlight[]

  @@map("users")
}

model Commentary {
  id        String   @id @default(cuid())
  book      String
  chapter   Int
  verse     Int?
  section   String
  content   String   @db.Text
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([book, chapter, verse, section])
  @@index([book, chapter, verse])
  @@map("commentaries")
}

model Note {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  book      String
  chapter   Int
  verse     Int
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
  @@index([userId])
  @@index([book, chapter, verse])
  @@map("notes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  book      String
  chapter   Int
  verse     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
  @@index([userId])
  @@map("bookmarks")
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  book      String
  chapter   Int
  verse     Int
  color     String   @default("yellow")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, book, chapter, verse])
  @@index([userId])
  @@map("highlights")
}

model DictionaryEntry {
  id            String   @id @default(cuid())
  term          String
  source        String
  definition    String   @db.Text
  vietnameseDef String?  @db.Text @map("vietnamese_def")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([term, source])
  @@index([term])
  @@index([source])
  @@map("dictionary_entries")
}
